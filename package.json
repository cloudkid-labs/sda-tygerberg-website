{
  "name": "tygerberg-sda-website",
  "type": "module",
  "version": "1.10.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-headers.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "headshots": "node scripts/headshot-fallbacks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/register.mjs --test \"test/**/*.test.?(m)[jt]s\"",
    "version:check": "node scripts/check-version.mjs",
    "smoke": "node scripts/smoke.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "astro": "^7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.4",
    "smol-toml": "^1.7.1",
    "svgo": "^4.1.0",
    "devalue": "^5.9.2"
  }
}
