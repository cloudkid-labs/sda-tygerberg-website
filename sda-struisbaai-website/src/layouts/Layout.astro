---
import '../styles/global.css';
import { withBase, canonicalPath } from '../lib/base';
import { churchJsonLd, websiteJsonLd } from '../lib/structuredData';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image for the social card. Defaults to the site card. */
  image?: string;
  ogType?: string;
}

const { title, description, image = '/og-image.png', ogType = 'website' } = Astro.props;

// Production origin on every build, devtest included — C-23.
const site = Astro.site!;
const canonical = new URL(canonicalPath(Astro.url.pathname), site);
const ogImage = new URL(image, site);

// Only the devtest build sets this. Everything else indexes normally.
const indexable = import.meta.env.PUBLIC_INDEXABLE !== 'false';

// Stamped by the production workflow so a served page can say which release it
// came from — `curl -s <url> | grep app-version` answers "what is live?" without
// the Cloudflare dashboard. A local or preview build sets neither and emits
// nothing, so absence means "not a tagged production build", which is the truth.
const appVersion = import.meta.env.PUBLIC_APP_VERSION;
const appCommit = import.meta.env.PUBLIC_APP_COMMIT;

// One @graph rather than two script tags: the WebSite node references the
// Church node as its publisher, and a single graph is what lets `@id` resolve.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [websiteJsonLd(site), churchJsonLd(site)],
};
---

<!doctype html>
<html lang="af">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {!indexable && <meta name="robots" content="noindex,nofollow" />}
    {appVersion && <meta name="app-version" content={appVersion} />}
    {appCommit && <meta name="app-commit" content={appCommit} />}

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <!-- iOS ignores SVG favicons; without this a bookmark gets a screenshot. -->
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <!-- The card people actually see — a church link travels by WhatsApp. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SDA Struisbaai — Sewendedag Adventiste Kerk, Wes-Kaap" />
    <meta property="og:site_name" content="SDA Struisbaai" />
    <!-- Ships as Afrikaans and swaps client-side, so that is what crawlers get. -->
    <meta property="og:locale" content="af_ZA" />
    <meta property="og:locale:alternate" content="en_ZA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Structured data is production-only: under noindex it carries no
        ranking weight, but it still feeds knowledge-graph/AI pipelines and
        makes the preview look authoritative in validators. Canonicals and OG
        stay on both builds deliberately — C-23. */}
    {indexable && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <!--
      Server-rendered: it must work on the first Tab press, before any island
      has hydrated, so it cannot read the language context. Both languages at
      once rather than Afrikaans alone — the toggle switches documentElement.lang
      to `en` and this text stayed Afrikaans, so a screen reader announced it
      with the wrong pronunciation. 404.astro already answers the same
      constraint the same way. C-54
    -->
    <a class="skip-link" href="#main">
      <span lang="af">Slaan oor na inhoud</span>
      <span aria-hidden="true"> · </span>
      <span lang="en">Skip to content</span>
    </a>
    <slot />
  </body>
</html>
