---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/base';
// A plain <img>, not the React <Logo>: this page ships no island on purpose,
// and an image needs no hydration. Same lockup as the headers (C-25 exception,
// Oct 2026).

// No React island here: an error page shouldn't pull down the app bundle just
// to render an apology. That also means no language toggle, so both languages
// are shown at once rather than picking one.
---

<Layout
  title="Bladsy nie gevind · SDA Struisbaai"
  description="Hierdie bladsy bestaan nie. Keer terug na die tuisblad."
>
  <main id="main" class="grid min-h-screen place-items-center px-7 py-16 text-center">
    <div>
      <img
        src={withBase('/oauth-logo.png')}
        width={56}
        height={56}
        alt="SDA Struisbaai"
        class="mx-auto mb-7 block h-14 w-14 rounded-[22%] object-cover"
      />
      <div class="mb-4 font-serif text-[64px] leading-none text-navy">404</div>
      <h1 class="mb-3 font-serif text-[28px] font-medium text-ink">
        Bladsy nie gevind
      </h1>
      <p class="mb-1 text-slate">Hierdie bladsy bestaan nie of is geskuif.</p>
      <p class="mb-8 text-slate-muted" lang="en">
        This page doesn't exist or has moved.
      </p>
      <a
        href={withBase('/')}
        class="inline-flex h-11 items-center justify-center rounded-pill bg-navy px-6 text-sm font-bold text-white hover:bg-navy-deep"
      >
        Tuisblad · Home
      </a>
    </div>
  </main>
</Layout>
