---
import Layout from '../layouts/Layout.astro';
import { Home } from '../components/react/Home';
import { SITE } from '../data/site';
import { FEATURE_FLAGS } from '../data/featureFlags';
import { embedPageUrl, parseLatestFromEmbedHtml, type LatestVideo } from '../lib/latestVideo';
import { buildHomePayload, HOME_PAYLOAD_ID } from '../lib/cms/payload';
import { scriptJson } from '../lib/cms/public';

/*
 * Build-time seed for the video preview card: the newest upload's id and
 * title, read from the embed page the same way the Worker reads it at request
 * time (src/lib/latestVideo.ts — one parser, two callers).
 *
 * The seed is what makes the card a real preview before hydration and on the
 * Pages deploy, which has no Worker to ask. Where a Worker exists the card
 * refreshes itself after mount, so build-time staleness only ever lasts until
 * hydration.
 *
 * Failure MUST degrade, never break the build: an offline builder gets `null`
 * and the card falls back to a generic link to the streams tab.
 */
let latestVideo: LatestVideo | null = null;
if (FEATURE_FLAGS.youtubeSection) {
  try {
    const list = new URL(SITE.youtubeUploadsEmbedUrl).searchParams.get('list') ?? '';
    const res = await fetch(embedPageUrl(list), {
      headers: { Referer: new URL('/', Astro.site).href },
      signal: AbortSignal.timeout(8000),
    });
    if (res.ok) latestVideo = parseLatestFromEmbedHtml(await res.text());
  } catch {
    // Offline or blocked build environment — the card degrades gracefully.
  }
}
---

<Layout
  title="SDA Struisbaai · Sewendedag Adventiste Kerk, Struisbaai"
  description="SDA Struisbaai kom elke Sabbat by Struisbaai Library Hall bymekaar, Wes-Kaap."
>
  {/* The CMS payload: the seed as at the build. The Worker swaps in live
      content per request and re-renders #week and #oor to match (C-70). It
      must come before the island — the Worker reads `build` from it before it
      reaches either section. */}
  <script is:inline type="application/json" id={HOME_PAYLOAD_ID} set:html={scriptJson(buildHomePayload())} />
  <Home client:load latestVideo={latestVideo} />
</Layout>
