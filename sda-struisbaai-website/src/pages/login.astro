---
import Layout from '../layouts/Layout.astro';
import { LoginPage } from '../components/react/LoginPage';
import { boardCopy } from '../data/boardCopy';

const copy = boardCopy;
---

<Layout
  title={`${copy.af.loginPageTitle} / ${copy.en.loginPageTitle}`}
  description={`${copy.af.loginPageDescription} / ${copy.en.loginPageDescription}`}
>
  <LoginPage client:load />
</Layout>
