---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
---

<Layout title="Map / Kaart · SDA Struisbaai" description="Directions to Struisbaai Library Hall. / Aanwysings na Struisbaai Library Hall.">
  <main class="mx-auto max-w-content px-7 py-16 text-center">
    <p class="mb-3 text-xs font-bold uppercase tracking-[.16em] text-orange">Google Maps</p>
    <h1 class="mb-5 font-serif text-3xl text-ink">Struisbaai Library Hall</h1>
    <a href={SITE.directionsUrl} target="_blank" rel="noopener" class="inline-flex rounded-pill bg-orange px-6 py-3 font-semibold text-white">
      Open directions / Kry aanwysings ↗
    </a>
  </main>
</Layout>
