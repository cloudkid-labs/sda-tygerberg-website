---
import Layout from '../../layouts/Layout.astro';
import { NoAccessPage } from '../../components/react/NoAccessPage';
import { membersCopy } from '../../data/membersCopy';

// Served with status 403 by the Worker, for a signed-in account that is not on
// the board list and for any /members request it refuses (C-70).
const copy = membersCopy;
---

<Layout
  title={`${copy.af.noAccessTitle} / ${copy.en.noAccessTitle}`}
  description={`${copy.af.noAccessBody} / ${copy.en.noAccessBody}`}
>
  <NoAccessPage client:load />
</Layout>
