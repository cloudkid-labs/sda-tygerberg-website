---
import '../../styles/tokens.css';
import Layout from '../../layouts/Layout.astro';
import { KerkraadPage } from '../../components/react/KerkraadPage';
import { boardCopy } from '../../data/boardCopy';

// Meta comes from the Afrikaans copy — the document ships as lang="af" and the
// toggle swaps the body text client-side, so the crawlable title stays Afrikaans.
// Private page: excluded from the sitemap and disallowed in robots.txt.
const copy = boardCopy.af;
---

<Layout title={copy.pageTitle} description={copy.pageDescription}>
  <KerkraadPage client:load />
</Layout>
