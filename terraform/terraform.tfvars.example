# Copy to terraform.tfvars (gitignored). Secrets are better passed as
# TF_VAR_brevo_api_key and TF_VAR_google_oauth_client_secret.

# Brevo -> Senders, domains & dedicated IPs -> Domains -> sdatygerberg.co.za
brevo_code = "<brevo-code value>"
brevo_dkim_records = {
  dkim1 = { type = "CNAME", name = "<name from Brevo>", content = "<target from Brevo>" }
  dkim2 = { type = "CNAME", name = "<name from Brevo>", content = "<target from Brevo>" }
}

# New Google Cloud project, created by this configuration.
google_project_id = "<globally-unique-id>"
# google_org_id   = "<numeric org id>"   # only if you have a Cloud organisation

# Leave both out for the first apply. After creating the Web client in Google
# Auth Platform, add them and apply again.
# google_oauth_client_id = "<digits>-<id>.apps.googleusercontent.com"

board_allowed_emails = [
  "<board member>@gmail.com",
]
