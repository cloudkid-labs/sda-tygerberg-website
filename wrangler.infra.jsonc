{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tygerberg-infra-map",
  "main": "./infra-worker.js",
  "compatibility_date": "2025-01-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "infra.sdatygerberg.co.za", "custom_domain": true }],
  "assets": {
    "directory": "./infra-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
