{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tygerberg-sda-website",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, an unknown path returns a bare 404 with an empty body —
    // the default is "none", and a 404.html in dist is ignored. GitHub Pages
    // picks 404.html up on its own, so only Cloudflare needs telling.
    "not_found_handling": "404-page",
    // Which paths reach the Worker script at all.
    //
    // `/*` is deliberate, and it is the whole set. The Worker logs every
    // request now (src/worker/requestLog.ts) — and a static hit is answered by
    // the asset store *before* the Worker would otherwise be invoked, so any
    // narrower list is a log with holes in it. The cost is a billable Worker
    // invocation per asset request. If the log ever stops being worth that,
    // narrow this back to ["/health", "/api/*", "/images/hod/*"] and keep the
    // negative pattern. C-60 has the history of what omitting a path does:
    // with `not_found_handling` above, a path with no file behind it gets
    // 404.html instead of the Worker — which is how /api/* went missing once,
    // found only by a user report. C-60, C-66
    //
    // The negative pattern keeps the headshot *fallbacks* on the default asset
    // path: they are what a browser is meant to get and they need no logic.
    // The masters stay inside the set because the guard in src/worker/index.ts
    // is what rewrites a direct hit to a fallback — without the Worker seeing
    // that path the guard would never run. C-51
    "run_worker_first": ["/*", "!/images/hod/fallback/*"]
  },
  // Workers Logs and Traces. The nested `logs` / `traces` blocks are the
  // per-signal switches and are what actually decides each one; the top-level
  // `enabled` is the older single toggle that only ever governed logs.
  //
  // `persist: true` keeps both in the Cloudflare dashboard, which is the only
  // place they are read from here — there is no external OTel destination
  // configured, so turning `persist` off would discard them entirely.
  //
  // `head_sampling_rate: 1` logs every request. Right for a site at this
  // traffic level; lower it if volume ever becomes a cost.
    "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    // When the LIVE badge is allowed to cost YouTube API quota, as a 5-field
    // cron expression read as a *window* (minute hour day-of-month month
    // day-of-week). Saturdays 09:00-12:59 SAST. Note cron day-of-week 6 is
    // Saturday (0 = Sunday); writing 7 would mean Sunday. Outside the window
    // no API call is made at all.
    //
    // The church streams 09:00-12:30. The hour field cannot express :30, and
    // erring short would drop the badge during the last half hour of a
    // service; erring long only permits polling, and the badge still appears
    // solely when YouTube reports a live stream. See C-14.
    //
    // Keep the minute field `*`. It controls whether the window is OPEN, not
    // how often YouTube is polled — narrowing it to `*\/5` would make the
    // badge vanish for the four minutes between each mark. Poll rate lives on
    // the client, in useLiveStatus.ts (every 5 minutes).
    "LIVE_CHECK_CRON": "* 9-12 * * 6",
    "LIVE_CHECK_TZ": "Africa/Johannesburg",

    // Contact-form delivery. These were Worker secrets; they are vars now by
    // decision — see C-31. TO is the church's real mailbox
    // (sdatygerbergklerk@gmail.com); FROM is the role address
    // welkom@sdatygerberg.co.za (not a mailbox itself — mail sent to it
    // reaches the clerk via the catch-all); BCC is the church-controlled
    // archive (archive@sdatygerberg.co.za). Not personal or church-member
    // data, and the cost of publishing them is spam to these mailboxes
    // rather than exposure of anyone's information. The From appears in
    // every message header anyway.
    //
    // Setting a Worker *secret* of the same name is the way back: remove the
    // line here and `wrangler secret put` it, and no code changes.
    //
    // CONTACT_EMAIL_TO and CONTACT_EMAIL_BCC must each be a verified
    // destination address on the account. The From is DKIM-aligned by the
    // cf-bounce records already in DNS; SETUP-INSTRUCTIONS §6.2 / Email
    // Sending is only needed to send to arbitrary recipients.
    //
    // CONTACT_EMAIL_BCC archives exactly one church-controlled copy of every
    // enquiry via the address's literal routing rule (SETUP-INSTRUCTIONS §6.6).
    // Re-added 2026-09: the old BCC went to an unread Worker inbox and could
    // fail the whole send on the free path (C-31). Re-removed 2026-10: a
    // personal monitoring inbox was added alongside archive@; a private mailbox
    // outside the church's control, with no retention rule, is the worst
    // available retention location. archive@sdatygerberg.co.za is a verified
    // destination address that terminates in R2 storage — the loop-safe shape
    // C-65 describes. That archive expires after 7 years under the R2 lifecycle
    // rule on the email-notifications bucket; SETUP-INSTRUCTIONS §3.6.
    // Every enquiry notification goes to each of these, one send each: the
    // clerk, the church account and the treasurer.
    "CONTACT_EMAIL_TO": "sdatygerbergklerk@gmail.com,sdatygerbergkerk@gmail.com,muller31jp@gmail.com",
    "CONTACT_EMAIL_FROM": "welkom@sdatygerberg.co.za",
    // Archive copy: the same message BCC'd to archive@sdatygerberg.co.za,
    // whose literal routing rule hands it to the r2-explorer Worker and into
    // R2. Must be a verified destination address (it is) AND listed in
    // allowed_destination_addresses below — out of step, the whole send is
    // rejected, not just the copy. CONCERNS.md C-65.
    "CONTACT_EMAIL_BCC": "archive@sdatygerberg.co.za",
    // Hostnames siteverify must echo back for /api/contact tokens — C-21.
    "TURNSTILE_HOSTNAMES": "sdatygerberg.co.za",
    // Board mail (/kerkraad). The role addresses the board may send as,
    // comma-separated like CONTACT_EMAIL_BCC. Public role addresses, so a var
    // (ADR-0001); the allow-list of board members stays a secret. Production
    // and devtest inherit this; devtest still answers `not-configured` until
    // its secrets are set, and it never sends without them.
    "MAIL_SEND_FROM": "welkom@sdatygerberg.co.za,klerk@sdatygerberg.co.za,tesourier@sdatygerberg.co.za,kerk@sdatygerberg.co.za",
    // Who may sign in. A plain-text var, not a secret, so the dashboard shows
    // the value instead of a hidden secret — the trade is that these personal
    // addresses are now readable to anyone with repo or Cloudflare access.
    // The repo is private; do not copy them onto the public site (C-20).
    "BOARD_ALLOWED_EMAILS": "muller31jp@gmail.com,sdatygerbergklerk@gmail.com,sdatygerbergkerk@gmail.com,rainiersvn1@gmail.com,johanemomberg@gmail.com,laurahoffman51@gmail.com",
    // Who may send as what, and so whose mail they see: Board mail shows each
    // member only threads and Sent items on addresses they may send as.
    // `email=address,address[;email=…]`; unlisted non-admins may use every
    // regular MAIL_SEND_FROM address; admins use and see everything.
    // Clerk (Sanet): klerk@, welkom@. Kerk: kerk@, welkom@. Treasurer:
    // tesourier@, welkom@. Johan: klerk@, welkom@, kerk@. Laura: welkom@.
    // The Settings tab (admins, C-71) overrides these two and MAIL_ROUTES and
    // CONTACT_EMAIL_TO once saved; until then they are the settings.
    "BOARD_SEND_AS": "sdatygerbergklerk@gmail.com=klerk@sdatygerberg.co.za,welkom@sdatygerberg.co.za;sdatygerbergkerk@gmail.com=kerk@sdatygerberg.co.za,welkom@sdatygerberg.co.za;muller31jp@gmail.com=tesourier@sdatygerberg.co.za,welkom@sdatygerberg.co.za;johanemomberg@gmail.com=klerk@sdatygerberg.co.za,welkom@sdatygerberg.co.za,kerk@sdatygerberg.co.za;laurahoffman51@gmail.com=welkom@sdatygerberg.co.za",
    // Board Mail admins can use every sender address, access all mail, and
    // delete inbox threads.
    "BOARD_ADMIN_EMAILS": "rainiersvn1@gmail.com",
    // Additional Board Mail identity usable only by administrators as From or
    // recipient. The archive's automatic BCC remains system-controlled.
    "BOARD_ADMIN_ONLY_EMAILS": "archive@sdatygerberg.co.za,rainier@sdatygerberg.co.za",

    // Inbound mail. Email Routing's catch-all for sdatygerberg.co.za hands
    // every address to this Worker; `inboundEmail.ts` forwards one copy to
    // each address below. Both must be **verified destination addresses** on
    // the account, and MAIL_ARCHIVE_TO must also have the literal routing rule
    // SETUP-INSTRUCTIONS §6.6 describes — out of step, that hop fails and is
    // logged. CONCERNS.md C-65.
    //
    // MAIL_FORWARD_TO is the delivery: when it fails the message is rejected,
    // so the sender learns. MAIL_ARCHIVE_TO is best-effort — by the time it is
    // attempted the church copy has already gone.
    "MAIL_FORWARD_TO": "sdatygerbergklerk@gmail.com",
    // Verified destination addresses on the Cloudflare account — the only
    // addresses the Settings tab may route mail or send notifications to.
    // Adding one: verify it in Email Routing first, then list it here and in
    // send_email.allowed_destination_addresses (a test keeps the two equal).
    "MAIL_DESTINATIONS": "sdatygerbergklerk@gmail.com,sdatygerbergkerk@gmail.com,muller31jp@gmail.com,rainiersvn1@gmail.com,archive@sdatygerberg.co.za",
    "MAIL_ARCHIVE_TO": "archive@sdatygerberg.co.za",
    // Per-address exceptions to MAIL_FORWARD_TO, archived and rejected on
    // failure the same way. tesourier@ is the address on the Zapper merchant
    // profile, so payment notifications reach the treasurer. Each destination
    // must be a verified destination address. Inbound forwards are not fenced
    // by send_email below.
    "MAIL_ROUTES": {
      "tesourier@sdatygerberg.co.za": "muller31jp@gmail.com",
      // The admin's own address: not the clerk's Gmail.
      "rainier@sdatygerberg.co.za": "rainiersvn1@gmail.com"
    }
  },
  // Lets /api/contact email the church directly.
  //
  // Fenced to exactly the addresses above. This became possible only once they
  // stopped being secrets (ADR-0001): while the destination was secret, naming
  // it here would have published it, so the binding had to stay unrestricted.
  // Now that it is public anyway, the fence costs nothing and bounds what a bug
  // in the Worker could do — a mistake in `contactEmail.ts` cannot mail a
  // stranger, it fails instead.
  //
  // Keep this in step with the `CONTACT_EMAIL_*` vars above: each address in
  // exactly two places — a recipient in its var and
  // `allowed_destination_addresses`, the From in its var and
  // `allowed_sender_addresses`. Out of step, Cloudflare rejects the whole
  // send. See C-31.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["sdatygerbergklerk@gmail.com", "sdatygerbergkerk@gmail.com", "muller31jp@gmail.com", "rainiersvn1@gmail.com", "archive@sdatygerberg.co.za"],
      "allowed_sender_addresses": ["welkom@sdatygerberg.co.za"]
    }
  ],
  // The Worker renders React for the CMS (src/worker/cmsRender.tsx, C-70) and
  // those components read `import.meta.env`, which only Vite defines. This is
  // the Worker's copy of the two values they read at module scope: BASE_URL,
  // and PUBLIC_IMAGE_CDN left undefined (= enabled). The build's own flags reach
  // the render through the page payload instead. Not inherited — env.devtest
  // repeats it.
  "define": {
    "import.meta.env": "{\"BASE_URL\":\"/\"}"
  },
  // Consent records for /api/contact submissions — CONCERNS.md C-34.
  //
  // A bucket that already existed in the account and had nothing writing to it:
  // the enquiry BCC then went to notifications@, which Email Routing handed to
  // the cloudkid-link-r2-explorer Worker, and that Worker was configured with
  // `targetBucket: "email-notifications"`. So consent was demonstrable only as
  // a raw .txt email dump in a different bucket. This binding is what makes the
  // Worker that *validates* consent also the one that records it.
  //
  // Remove the binding and submissions still work: `storeConsent` treats an
  // unbound namespace as "not configured" and the enquiry email keeps carrying
  // the consent line, exactly as before.
  //
  // Retention is not expressible here — R2 lifecycle rules live on the buckets,
  // not in this file. Both are configured: `consent-cloudkid-link` and
  // `email-notifications` each expire after 7 years, set 2026-10-04 via
  // `wrangler r2 bucket lifecycle`. See SETUP-INSTRUCTIONS.md §3.6.
  "r2_buckets": [
    {
      "binding": "CONSENT",
      "bucket_name": "consent-cloudkid-link"
    },
    // Visitor submissions for the /kerkraad inbox. Same 7-year retention as
    // consent (lifecycle rule lives on the bucket, set at creation). C-69.
    // Create with: wrangler r2 bucket create tygerberg-submissions
    {
      "binding": "SUBMISSIONS",
      "bucket_name": "tygerberg-submissions"
    },
    // Website content for the members-area CMS: events, department heads,
    // pages (draft and live), images, history and the audit log — C-70.
    // Created by terraform/ (cloudflare_r2_bucket.cms), which must be applied
    // BEFORE a deploy carrying this binding: wrangler refuses to deploy against
    // a bucket that does not exist. Unbound, the site serves the seed and
    // /api/cms answers `not-configured`.
    {
      "binding": "CMS",
      "bucket_name": "tygerberg-cms"
    }
  ],
  "routes": [
    // Production custom domain (the sdatygerberg.co.za zone lives in the
    // Cloudflare account) — `wrangler deploy` provisions/attaches this
    // automatically. The apex is canonical; www -> apex is a zone Redirect
    // Rule, not a Worker route (run_worker_first is path-scoped, so a host
    // redirect cannot live in the Worker). See SETUP-INSTRUCTIONS §domains
    // and C-61.
    { "pattern": "sdatygerberg.co.za", "custom_domain": true }
  ],

  // Devtest — the integration preview, deployed from `dev` by
  // deploy-devtest-cloudflare.yml. A SECOND Worker
  // (`tygerberg-sda-website-devtest`) on the old production hostname,
  // replacing the sunset GitHub Pages preview (C-61). It inherits `main`,
  // `assets` (so `run_worker_first` routes /api/* here too) and
  // `observability`; only the non-inheritable keys below are redeclared.
  //
  // Deliberately no `send_email`, `r2_buckets` or CONTACT_EMAIL_* vars: a
  // preview must never email the church or write consent records to the
  // production bucket, so /api/contact answers `not-configured` here. The LIVE
  // badge never lights either — the devtest Worker carries no YOUTUBE_API_KEY,
  // so liveStatus stays not-live and the latest-video card falls back to the
  // keyless embed-page scrape, which needs no secret.
  "env": {
    "devtest": {
      "name": "tygerberg-sda-website-devtest",
      "routes": [{ "pattern": "tygerberg-sda.cloudkid.link", "custom_domain": true }],
      "define": {
        "import.meta.env": "{\"BASE_URL\":\"/\"}"
      },
      "vars": {
        "LIVE_CHECK_CRON": "* 9-12 * * 6",
        "LIVE_CHECK_TZ": "Africa/Johannesburg",
        // Hostnames siteverify must echo back for /api/contact tokens — C-21.
        "TURNSTILE_HOSTNAMES": "tygerberg-sda.cloudkid.link",
        // Who may sign in to the members area on the preview — the same people
        // as production (vars do not inherit, so they are repeated; a test keeps
        // the two in step). Sign-in also needs GOOGLE_CLIENT_ID,
        // GOOGLE_CLIENT_SECRET and SESSION_SECRET, which the devtest workflow
        // uploads; SESSION_SECRET is the preview's own (DEVTEST_SESSION_SECRET,
        // terraform/), so a preview session never verifies on production.
        // Board mail is switched off here entirely: BOARD_MAIL "off" makes
        // every /api/mail/* route but the session check answer 404, and the
        // members page hides the tab. (There is no MAIL_SEND_FROM or
        // BREVO_API_KEY either, so it could never send — C-61.) C-70
        "BOARD_ALLOWED_EMAILS": "muller31jp@gmail.com,sdatygerbergklerk@gmail.com,sdatygerbergkerk@gmail.com,rainiersvn1@gmail.com,johanemomberg@gmail.com,laurahoffman51@gmail.com",
        "BOARD_SEND_AS": "sdatygerbergklerk@gmail.com=klerk@sdatygerberg.co.za,welkom@sdatygerberg.co.za;sdatygerbergkerk@gmail.com=kerk@sdatygerberg.co.za,welkom@sdatygerberg.co.za;muller31jp@gmail.com=tesourier@sdatygerberg.co.za,welkom@sdatygerberg.co.za;johanemomberg@gmail.com=klerk@sdatygerberg.co.za,welkom@sdatygerberg.co.za,kerk@sdatygerberg.co.za;laurahoffman51@gmail.com=welkom@sdatygerberg.co.za",
        "BOARD_ADMIN_EMAILS": "rainiersvn1@gmail.com",
        "BOARD_ADMIN_ONLY_EMAILS": "archive@sdatygerberg.co.za,rainier@sdatygerberg.co.za",
        "BOARD_MAIL": "off"
      },
      // Devtest reads and writes its own submissions bucket, so trialling the
      // inbox never touches the production queue. Create with:
      // wrangler r2 bucket create tygerberg-submissions-devtest
      //
      // CMS: the preview's own content bucket, created by terraform/
      // (cloudflare_r2_bucket.cms_devtest). Apply that BEFORE the next devtest
      // deploy — wrangler refuses a binding to a bucket that does not exist.
      // C-70
      "r2_buckets": [
        {
          "binding": "SUBMISSIONS",
          "bucket_name": "tygerberg-submissions-devtest"
        },
        {
          "binding": "CMS",
          "bucket_name": "tygerberg-cms-devtest"
        }
      ]
      // No send_email, r2_buckets or CONTACT_EMAIL_* here on purpose: a preview
      // sends no church email and writes no consent records, so /api/contact
      // answers `not-configured` (C-61). wrangler prints an advisory warning
      // that these top-level bindings are not inherited — expected and correct;
      // declaring them empty only makes the warning noisier, so they are simply
      // omitted.
    }
  }
}
